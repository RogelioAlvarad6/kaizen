# Copy to backend/.env for running Kaizen locally (start.ps1). Never commit the real .env.

# --- Optional: parked AI features (chat, Obsidian wiki, workflow canvas) ---
# Only needed if you set ENABLE_AI_AUTOMATIONS=true or re-enable the AI pages.
ANTHROPIC_API_KEY=
ENABLE_AI_AUTOMATIONS=false
VAULT_PATH=C:\path\to\your\Obsidian Vault
WIKI_FOLDER=AI-Wiki
DEFAULT_MODEL=claude-opus-5-5
DEFAULT_EFFORT=medium
MONTHLY_BUDGET_USD=20

# --- Optional: Discord nudges ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_USER_ID=123456789012345678
# KAIZEN_TZ=America/Chicago
# KAIZEN_URL=http://localhost:8000
